{
  "name": "themia",
  "private": true,
  "author": "Nathaniel Walser",
  "license": "Elastic-2.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "tauri": "tauri",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build-local.ps1",
    "vite:build": "vite build",
    "vite:dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "coverage:spec": "node scripts/spec-coverage.mjs",
    "test:unit": "vitest run",
    "test:presets": "vitest run --config vitest.presets.config.ts",
    "test:brands": "vitest run --config vitest.brands.config.ts",
    "gen:brands": "node scripts/gen-brand-icons.mjs",
    "test:rust:email": "cargo test --manifest-path widgets/office/email/Cargo.toml",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "test:e2e:build": "tauri build --debug --no-bundle",
    "test:e2e": "wdio run ./tests/e2e/wdio.conf.ts",
    "test:e2e:spec": "wdio run ./tests/e2e/wdio.conf.ts --spec",
    "test:e2e:all": "npm run test:e2e:build && npm run test:e2e",
    "shots": "wdio run ./tests/shots/shots.conf.ts",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release-local.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/chai": "^5.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@wdio/cli": "^9.4.4",
    "@wdio/local-runner": "^9.4.4",
    "@wdio/mocha-framework": "^9.2.8",
    "@wdio/spec-reporter": "^9.2.14",
    "chai": "^5.1.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.3",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^4.1.8",
    "webdriverio": "^9.4.4"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@telemetrydeck/sdk": "^2.0.4",
    "lucide-solid": "^1.7.0",
    "solid-js": "^1.8.18"
  }
}
