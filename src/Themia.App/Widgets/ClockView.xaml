<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Themia.App.Widgets.ClockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root">

        <!--
            Digital face. The clock is the hero of its tile, so the readout still grows with the box
            the user drew — but it grows by picking a step of the Windows 11 type ramp (and, past the
            ramp's top, a multiple of it that keeps Fluent's own line-height ratio) rather than by
            taking a fraction of the width. See ApplyTypeScale.

            Deliberately not a Viewbox: that stretches an already-rendered glyph, and text laid out
            at 48px and blown up four times is soft where text laid out at 192px is sharp.
        -->
        <StackPanel x:Name="DigitalRoot" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel
                x:Name="TimeRow"
                Orientation="Horizontal"
                HorizontalAlignment="Center">
                <TextBlock
                    x:Name="TimeText"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    VerticalAlignment="Bottom"
                    Text="00:00" />
                <TextBlock
                    x:Name="MeridiemText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed"
                    Text="AM" />
            </StackPanel>
            <TextBlock
                x:Name="DateText"
                HorizontalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="" />
        </StackPanel>

        <!--
            Analog face. Built in code at the tile's own pixel scale (see BuildAnalogFace) rather
            than drawn small and scaled up by a Viewbox: a Windows clock face is hairline ticks and
            thin hands, and a hairline that has been through a 4x Viewbox is a 4px rule. Everything
            on it is a named theme brush.
        -->
        <Grid x:Name="AnalogRoot" Visibility="Collapsed">
            <Canvas
                x:Name="AnalogFace"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

    </Grid>
</UserControl>
