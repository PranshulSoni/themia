<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Themia.App.Widgets.ClockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root">

        <!--
            Digital face. Font sizes are computed from the tile in code-behind rather than fixed
            here, so the clock fills whatever box the user drew. Deliberately not a Viewbox: that
            stretches an already-rendered glyph, and text laid out at 48px and blown up four times
            is soft where text laid out at 192px is sharp.
        -->
        <Grid x:Name="DigitalRoot" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                    <TextBlock
                        x:Name="TimeText"
                        FontWeight="SemiBold"
                        LineHeight="0"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        VerticalAlignment="Center"
                        Text="00:00" />
                    <TextBlock
                        x:Name="MeridiemText"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Bottom"
                        Visibility="Collapsed"
                        Text="AM" />
                </StackPanel>
                <TextBlock
                    x:Name="DateText"
                    HorizontalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="" />
            </StackPanel>
        </Grid>

        <!-- Analog face. Laid out in a fixed 100x100 space; the Viewbox scales it to fill the tile,
             which is correct here because it is vector geometry, not text. -->
        <Viewbox
            x:Name="AnalogRoot"
            Stretch="Uniform"
            Visibility="Collapsed">
            <Grid Width="100" Height="100">
                <Ellipse
                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                    StrokeThickness="1.5"
                    Fill="Transparent" />

                <Rectangle
                    x:Name="HourHand"
                    Width="3.5"
                    Height="26"
                    RadiusX="1.75"
                    RadiusY="1.75"
                    Fill="{ThemeResource TextFillColorPrimaryBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform Y="-13" />
                            <RotateTransform x:Name="HourRotation" CenterX="1.75" CenterY="26" />
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <Rectangle
                    x:Name="MinuteHand"
                    Width="2.5"
                    Height="38"
                    RadiusX="1.25"
                    RadiusY="1.25"
                    Fill="{ThemeResource TextFillColorPrimaryBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform Y="-19" />
                            <RotateTransform x:Name="MinuteRotation" CenterX="1.25" CenterY="38" />
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <Rectangle
                    x:Name="SecondHand"
                    Width="1"
                    Height="42"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform Y="-21" />
                            <RotateTransform x:Name="SecondRotation" CenterX="0.5" CenterY="42" />
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <Ellipse
                    Width="6"
                    Height="6"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
        </Viewbox>

    </Grid>
</UserControl>
